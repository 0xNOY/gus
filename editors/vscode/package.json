{
  "name": "gus",
  "displayName": "GUS - Git User Switcher",
  "description": "Selects the correct Git identity for each protected IDE session.",
  "publisher": "0xnoy",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xNOY/gus.git"
  },
  "private": true,
  "type": "module",
  "main": "./dist/src/extension.js",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "categories": [
    "SCM Providers"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gus.showDiagnostics",
        "title": "GUS: Show Diagnostics"
      }
    ]
  },
  "files": [
    "dist/src/**",
    "bin/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:native-e2e": "npm run build && node --test test/native-e2e.test.mjs",
    "package:vsix": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.0"
  }
}
